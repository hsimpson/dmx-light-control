{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project frontend --web",
  "targets": {
    "start": {
      "executor": "@nx/next:server",
      "options": {
        "buildTarget": "frontend:build",
        "port": 3001
      }
    },
    "extract-i18n": {
      "executor": "nx:run-commands",
      "options": {
        "command": "formatjs extract 'src/**/*.{ts,tsx,js,jsx}' --ignore='**/*.d.ts' --out-file src/lang/en.json --id-interpolation-pattern '[sha512:contenthash:base64:6]' --format simple --additional-function-names t --pragma formatjs --throws",
        "cwd": "apps/frontend"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "apps/frontend"
      }
    },
    "graphql-codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "graphql-codegen",
        "cwd": "apps/frontend"
      }
    }
  }
}
