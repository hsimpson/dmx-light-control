{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "targets": {
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": ["{workspaceRoot}/dist/apps/backend/package.json", "{workspaceRoot}/dist/apps/backend/pnpm-lock.yaml"],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/backend/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "backend:build",
        "runBuildTargetDependencies": false,
        "watch": true
      },
      "configurations": {
        "development": {
          "buildTarget": "backend:build:development"
        },
        "production": {
          "buildTarget": "backend:build:production",
          "watch": false
        }
      },
      "dependsOn": [{ "projects": ["infra"], "target": "db-start" }]
    },
    "dmx-sniffer": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/backend/main.js dmx-sniffer"
      }
    },
    "drizzle-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit generate --config=./src/db/drizzle.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "drizzle-migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit migrate --config=./src/db/drizzle.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "drizzle-seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/db/seeding/seed.ts",
        "cwd": "{projectRoot}"
      }
    },
    "drizzle-studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit studio --config=./src/db/drizzle.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "erd": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/db/generate-erd.ts",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": []
}
